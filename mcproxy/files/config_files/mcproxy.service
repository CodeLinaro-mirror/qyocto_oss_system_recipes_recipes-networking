[Unit]
Description=Set mcproxy init parameters
After=network.target

[Service]
Type=simple
ExecStart=/bin/sh -c "/usr/sbin/mcproxy_init_service start"
ExecStop=/bin/sh -c "/usr/sbin/mcproxy_init_service stop"
ExecReload=/bin/sh -c "/usr/sbin/mcproxy_init_service restart"
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
